# Server binding
HOST=127.0.0.1
PORT=3456

# Client gateway bearer token(s), comma-separated. OPTIONAL bootstrap only.
# Leave it unset: a random `sk-aq-...` key is generated on first start (copy it from Web Console -> Sub-Keys).
# If you set it, use a long random secret (e.g. `openssl rand -hex 24`); placeholder values are rejected at startup.
# Keys seeded from here are tagged ".env" in the console; deleting one there revokes it permanently,
# and removing/changing the token here removes/replaces the key on the next restart.
# GATEWAY_TOKEN=sk-aq-<generate-your-own>

# Web Console (/dashboard)
ENABLE_DASHBOARD=true
DASHBOARD_PATH=/dashboard
# Required on any remotely reachable deployment. If unset, the console password can only be initialized from localhost.
# ADMIN_PASSWORD=<set-a-strong-password>

# Upstream AWS Quick credentials (comma-separated)
# Use `local-outpost` to auto-refresh from local signed-in Amazon Quick.app,
# or import a raw `id_token` / `wsHost|id_token`.
QUICK_TOKENS=local-outpost

# Privacy defaults (native INCOGNITO=true leaves zero cloud history)
INCOGNITO=true
# Override desktop client appVersion header if AWS enforces a minimum version upgrade
# AWS_QUICK_APP_VERSION=1.2.4757

# Emit routed AWS Quick model & effort in thinking/reasoning header (also configurable live in Web Console):
# `true` (default) = show only on thinking-enabled turns (`effort != off` or upstream thinking), keeping plain `effort=off` replies clean for legacy/Anthropic/Responses clients
# `always` = show compact routed header on EVERY turn (including `effort=off` and explicit `thinking.disabled` / `reasoning_effort=none`)
# `false` = disable thinking header (HTTP headers `x-quick-mode`/`x-quick-effort`/`x-quick-routed-model` & trace logs still kept)
SHOW_ROUTED_MODEL_IN_THINKING=true
# Enable AWS Quick native web search (default true)
WEB_SEARCH_ENABLED=true
# Automatically find or create & bind a minimal custom agent (`Coding Assistant`) per account (default true)
AUTO_ENSURE_CODING_AGENT=true
# Optional custom instructions template used when auto-creating custom agents (leave empty for built-in default)
# CUSTOM_AGENT_PROMPT=
# Opt-in deep sanitization for heavy IDE/agent client wrappers in `systemPrompt` (default false; user system prompts stay untouched unless enabled)
# SANITIZE_CLIENT_SYSTEM_PROMPT=false
# Opt-in defensive auto-rephrase on upstream `content_filtered` (default false; retries once on the SAME requested model)
# AUTO_REPHRASE_ON_CONTENT_FILTER=false
# Optional custom prompt template for defensive auto-rephrase (leave empty for built-in default)
# CONTENT_FILTER_REPHRASE_PROMPT=
# Helper model used strictly for short prompt rephrasing (`quick-fast` or `quick-balanced`; never replaces the answering model)
# CONTENT_FILTER_REPHRASE_MODEL=quick-fast
# Optional global default AWS Quick custom Agent ID (`chat_agent_id`, mainly for single-account setups)
# CHAT_AGENT_ID=

# Local headless outpost settings (macOS)
QUICKWORK_OUTPOST_PORT=18780
# QUICKWORK_AGENT_PATH=/Applications/Amazon Quick.app/Contents/Resources/agent/quickwork-agent

# Optional outbound proxy (global default; per-credential proxies can be set in Web Console)
# HTTPS_PROXY=http://127.0.0.1:7891
# HTTP_PROXY=http://127.0.0.1:7891
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1,*.internal

# GitHub Releases update notification in Web Console (default: kuk-888/aws-quick2api; set `off` to disable)
# UPDATE_CHECK_REPO=kuk-888/aws-quick2api
# Warm incremental session cache (applies to both incognito dedicated-WS mode and cloud mode)
# WARM_SESSION_TTL_MS=1800000
# MAX_WARM_SESSIONS=256
# Disable Web Console one-click hot-update & rollback (default: false)
# DISABLE_SELF_UPDATE=true
